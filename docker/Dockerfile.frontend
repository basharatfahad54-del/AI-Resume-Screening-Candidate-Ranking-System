# TalentMatch web client
#
# Build: Vite emits a static bundle, nginx serves it and reverse-proxies /api to
# the backend container. Same-origin API calls mean no CORS preflight in the
# browser and no API URL baked into the bundle.
#
# Verified locally on Linux/macOS. It has NOT been built in this environment
# (no Docker daemon), so `docker compose build` is the first real check.

# ---------- Stage 1: build ----------
FROM node:22-alpine AS builder

ENV CI=true
WORKDIR /app

# Copy manifests first so `npm ci` is cached until dependencies actually change.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./

# Same origin: leave VITE_API_URL empty and let nginx proxy /api.
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# ---------- Stage 2: serve ----------
# nginx-unprivileged already runs as a non-root user on 8080 with a writable
# pid path and cache directory, so no chown or capability is needed.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]