# Copy to .env.local and adjust. Every value here is read at build time.

# Leave empty to use the same origin. The dev server proxies /api to
# VITE_PROXY_TARGET, and nginx does the same in production.
VITE_API_URL=

# Dev only: where the Vite dev proxy forwards /api requests.
VITE_PROXY_TARGET=http://127.0.0.1:8000