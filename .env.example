# Copy to .env and adjust. Never commit real secrets.

# ---------- Application ----------
APP_NAME="AI Resume Screening"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
LOG_LEVEL=INFO
# Interactive API docs (/docs, /redoc, /openapi.json).
# Unset = on in development and test, off in staging and production.
# Set to true to expose them in production; the schema is a full route inventory.
#EXPOSE_API_DOCS=false

# ---------- Database ----------
# Development default (no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
# Production (docker compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_resume
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_resume
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Security ----------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
# Cost factor for password hashing. Raise it as hardware improves; every
# increase also makes login slower, and existing hashes are re-hashed on the
# next successful login.
BCRYPT_ROUNDS=12

# ---------- Bootstrap administrator ----------
# On startup the app creates this account if the users table is empty. Without it
# a fresh database has no way in: public registration only creates recruiters.
# Change the password after the first sign-in, then clear ADMIN_PASSWORD.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-first-run

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- File uploads ----------
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx,.txt
RETENTION_DAYS=365

# ---------- Rate limiting ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ---------- AI providers ----------
# embeddings: sentence_transformers | openai | hashing
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=384

# llm: openai | none  (used for optional structured extraction / assistant)
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini

# ---------- Ranking defaults (weights must sum to 1.0) ----------
W_REQUIRED_SKILLS=0.40
W_EXPERIENCE=0.20
W_EDUCATION=0.15
W_PREFERRED_SKILLS=0.10
W_SEMANTIC=0.10
W_CERTIFICATIONS=0.05

# ---------- Frontend (Vite, read at build time) ----------
# Leave empty to call the same origin; the dev server and nginx both proxy
# /api to the backend. Set an absolute URL only for a split deployment.
VITE_API_URL=
